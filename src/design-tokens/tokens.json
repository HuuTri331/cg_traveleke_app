{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "version": "1.0.0",
  "name": "Traveleke Enterprise Design Tokens",
  "description": "Single Source of Truth for Traveloka/Traveleke Design System tokens synchronized with Figma",
  "tokens": {
    "typography": {
      "fontFamily": {
        "inter": {
          "value": "var(--font-inter), system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "type": "fontFamily",
          "description": "Primary sans font for UI body text and data tables"
        },
        "outfit": {
          "value": "var(--font-outfit), system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif",
          "type": "fontFamily",
          "description": "Display font for headings and brand marketing banners"
        }
      },
      "fontSize": {
        "3xs": {
          "value": "0.5625rem",
          "lineHeight": "0.75rem",
          "type": "fontSize",
          "description": "Micro label 9px for flight codes and compact badges"
        },
        "2xs": {
          "value": "0.625rem",
          "lineHeight": "0.875rem",
          "type": "fontSize",
          "description": "Sub-caption 10px for hotel address metadata"
        },
        "xs-plus": {
          "value": "0.6875rem",
          "lineHeight": "0.9375rem",
          "type": "fontSize",
          "description": "Intermediate caption 11px for status pill indicators"
        }
      }
    },
    "spacing": {
      "card-sm": { "value": "1rem", "type": "spacing" },
      "card": { "value": "1.5rem", "type": "spacing" },
      "card-lg": { "value": "2rem", "type": "spacing" },
      "section": { "value": "2.5rem", "type": "spacing" },
      "section-lg": { "value": "4rem", "type": "spacing" },
      "sidebar": { "value": "17.5rem", "type": "spacing" }
    },
    "color": {
      "brand": {
        "50": { "value": "#f0f4ff", "type": "color" },
        "100": { "value": "#e0e8ff", "type": "color" },
        "200": { "value": "#c7d6fe", "type": "color" },
        "300": { "value": "#a5bbfd", "type": "color" },
        "400": { "value": "#8198f8", "type": "color" },
        "500": { "value": "#465fff", "type": "color" },
        "600": { "value": "#3b50df", "type": "color" },
        "700": { "value": "#2d3bb8", "type": "color" },
        "800": { "value": "#242f92", "type": "color" },
        "900": { "value": "#1d2571", "type": "color" }
      },
      "traveloka": {
        "blue": {
          "value": "#0194f3",
          "type": "color",
          "description": "Primary Traveloka Blue brand identity"
        },
        "blue-hover": {
          "value": "#0080d4",
          "type": "color",
          "description": "Primary Traveloka Blue interactive hover state"
        },
        "blue-dark": {
          "value": "#0073be",
          "type": "color",
          "description": "Primary Traveloka Blue active press state"
        },
        "blue-subtle": {
          "value": "#f2f8fc",
          "type": "color",
          "description": "Subtle light blue background tint for order form cards"
        },
        "blue-light": {
          "value": "#eaf4ff",
          "type": "color",
          "description": "Light blue background for callouts and info banners"
        },
        "blue-border": {
          "value": "#e5f0fa",
          "type": "color",
          "description": "Subtle border line for blue tinted containers"
        },
        "blue-border-light": {
          "value": "#d6ebf8",
          "type": "color",
          "description": "Light border for alert banners"
        },
        "orange": {
          "value": "#ff5e1f",
          "type": "color",
          "description": "Vibrant Traveloka Orange for pricing and primary CTA highlights"
        },
        "orange-hover": {
          "value": "#e04e14",
          "type": "color",
          "description": "Orange hover state"
        },
        "orange-subtle": {
          "value": "#fff1eb",
          "type": "color",
          "description": "Subtle warm orange background for discounts and promo tags"
        },
        "navy": {
          "value": "#1a4b75",
          "type": "color",
          "description": "Traveloka Navy used for hotel tag badges and overlay chips"
        },
        "surface": {
          "value": "#f2f4f7",
          "type": "color",
          "description": "Neutral page surface background for checkout and order processing"
        },
        "surface-light": {
          "value": "#f7f9fa",
          "type": "color",
          "description": "Secondary subtle surface tint"
        }
      },
      "semantic": {
        "success": { "value": "#10b981", "type": "color" },
        "warning": { "value": "#f59e0b", "type": "color" },
        "danger": { "value": "#ef4444", "type": "color" },
        "info": { "value": "#0284c7", "type": "color" }
      }
    }
  }
}
